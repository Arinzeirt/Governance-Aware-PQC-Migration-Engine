import streamlit as st


STEP_LABELS = {
    1: "Continue to Technology Landscape →",
    2: "Continue to Cryptographic Posture →",
    3: "Continue to Governance & Risk →",
    4: "View Assessment Results →",
}


def show(
    current_step,
    can_continue=True,
    on_continue=None,
):

    left, spacer, right = st.columns(
        [2, 4, 3],
        gap="medium",
    )

    with left:

        if current_step > 1:

            if st.button(
                "← Back",
                key=f"assessment_back_{current_step}",
                use_container_width=True,
            ):

                st.session_state.assessment["step"] -= 1
                st.rerun()

    with spacer:

        st.empty()

    with right:

        if st.button(
            STEP_LABELS[current_step],
            key=f"assessment_next_{current_step}",
            type="primary",
            use_container_width=True,
            disabled=not can_continue,
        ):

            if on_continue:
                on_continue()

            if current_step < 4:

                st.session_state.assessment["step"] += 1
                st.rerun()

            else:

                st.session_state[
                    "assessment_results"
                ] = True

                st.rerun()
