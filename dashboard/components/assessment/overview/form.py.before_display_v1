import streamlit as st

from content.industries import INDUSTRIES
from content.countries import COUNTRIES

from components.assessment.validation import (
    overview_complete,
    valid_email,
)

from components.assessment.store import (
    save,
    load,
    assessment_id,
    set_assessment_id,
)

from components.assessment.id_generator import (
    generate,
)


def show():

    existing = load("overview")

    with st.container(border=True):

        # =====================================================
        # ENTERPRISE OVERVIEW
        # =====================================================

        st.markdown(
            """
            <div style="
                font-size:1.50rem;
                font-weight:750;
                line-height:1.1;
                margin-bottom:4px;
            ">
                Enterprise Overview
            </div>
            """,
            unsafe_allow_html=True,
        )

        st.caption(
            "Establish the organisational, business and operating "
            "context required to assess quantum-readiness risk."
        )

        # =====================================================
        # ASSESSMENT CONTACT
        # =====================================================

        st.markdown(
            """
            <div style="
                font-size:0.90rem;
                font-weight:700;
                margin:12px 0 7px 0;
            ">
                Assessment Contact
            </div>
            """,
            unsafe_allow_html=True,
        )

        contact_left, contact_right = st.columns(
            2,
            gap="medium",
        )

        with contact_left:

            st.text_input(
                "Full Name *",
                key="respondent_name",
                value=existing.get(
                    "respondent_name",
                    "",
                ),
                placeholder="Full name",
            )

        with contact_right:

            roles = [
                "Executive / C-Suite",
                "CIO / CTO",
                "CISO / Security Lead",
                "IT / Infrastructure",
                "Risk / Compliance",
                "Architecture / Engineering",
                "Audit",
                "Other",
            ]

            existing_role = existing.get(
                "respondent_role"
            )

            role_index = (
                roles.index(existing_role)
                if existing_role in roles
                else None
            )

            st.selectbox(
                "Role / Job Title *",
                roles,
                index=role_index,
                key="respondent_role",
                placeholder="Select role",
            )

        st.text_input(
            "Business Email *",
            key="respondent_email",
            value=existing.get(
                "respondent_email",
                "",
            ),
            placeholder="name@company.com",
        )

        # =====================================================
        # ORGANISATION
        # =====================================================

        st.markdown(
            """
            <div style="
                font-size:0.90rem;
                font-weight:700;
                margin:14px 0 7px 0;
            ">
                Organisation
            </div>
            """,
            unsafe_allow_html=True,
        )

        left, right = st.columns(
            2,
            gap="medium",
        )

        # ==================================================
        # LEFT
        # ==================================================

        with left:

            st.text_input(
                "Organisation Name *",
                key="organisation_name",
                value=existing.get(
                    "organisation_name",
                    "",
                ),
                placeholder="Enet Technologies Ltd",
            )

            st.selectbox(
                "Industry *",
                INDUSTRIES,
                key="industry",
                index=None,
                placeholder="Select industry",
            )

            st.selectbox(
                "Primary Business Model *",
                [
                    "Financial Services",
                    "Technology / Platform",
                    "Government / Public Sector",
                    "Healthcare",
                    "Manufacturing",
                    "Telecommunications",
                    "Energy / Utilities",
                    "Other",
                ],
                key="primary_business_model",
                index=None,
                placeholder="Select primary business model",
            )

            st.selectbox(
                "Organisation Size *",
                [
                    "1–50",
                    "51–250",
                    "251–1000",
                    "1000+",
                ],
                key="organisation_size",
                index=None,
                placeholder="Select organisation size",
            )

            st.radio(
                "Critical Infrastructure *",
                [
                    "Yes",
                    "No",
                ],
                horizontal=True,
                key="critical_infrastructure",
            )

        # ==================================================
        # RIGHT
        # ==================================================

        with right:

            st.text_input(
                "Official Business Email *",
                key="organisation_email",
                value=existing.get(
                    "organisation_email",
                    "",
                ),
                placeholder="security@company.com",
            )

            st.selectbox(
                "Country *",
                COUNTRIES,
                key="country",
                index=None,
                placeholder="Select country",
            )

            st.multiselect(
                "Regulatory Environment *",
                [
                    "Data Protection / Privacy",
                    "Banking / Financial Services",
                    "Healthcare Regulation",
                    "Payment / Financial Infrastructure",
                    "Telecommunications",
                    "Energy / Utilities Regulation",
                    "International / Cross-Border",
                    "Other",
                ],
                key="regulatory_environment",
                default=existing.get(
                    "regulatory_environment",
                    [],
                ),
                placeholder=(
                    "Select applicable regulatory environments"
                ),
            )

            st.multiselect(
                "Most Critical Business Services *",
                [
                    "Core Banking / Financial Services",
                    "Payments",
                    "Customer Identity",
                    "Digital Channels",
                    "Communication Services",
                    "Data Processing",
                    "Cloud Services",
                    "Other",
                ],
                key="critical_business_services",
                default=existing.get(
                    "critical_business_services",
                    [],
                ),
                placeholder="Select critical services",
            )

    # ======================================================
    # DATA
    # ======================================================

    data = {

        # ----------------------------------------------
        # Assessment contact
        # ----------------------------------------------

        "respondent_name":
            st.session_state.get(
                "respondent_name",
                "",
            ),

        "respondent_role":
            st.session_state.get(
                "respondent_role"
            ),

        "respondent_email":
            st.session_state.get(
                "respondent_email",
                "",
            ),

        # ----------------------------------------------
        # Organisation
        # ----------------------------------------------

        "organisation_name":
            st.session_state.get(
                "organisation_name",
                "",
            ),

        "organisation_email":
            st.session_state.get(
                "organisation_email",
                "",
            ),

        "industry":
            st.session_state.get(
                "industry"
            ),

        "country":
            st.session_state.get(
                "country"
            ),

        "primary_business_model":
            st.session_state.get(
                "primary_business_model"
            ),

        "regulatory_environment":
            st.session_state.get(
                "regulatory_environment",
                [],
            ),

        "organisation_size":
            st.session_state.get(
                "organisation_size"
            ),

        "critical_business_services":
            st.session_state.get(
                "critical_business_services",
                [],
            ),

        "critical_infrastructure":
            st.session_state.get(
                "critical_infrastructure"
            ),

    }

    save(
        "overview",
        data,
    )

    # ======================================================
    # ASSESSMENT ID
    # ======================================================

    if (
        assessment_id() is None
        and data["country"]
        and data["industry"]
    ):

        set_assessment_id(
            generate(
                data["country"],
                data["industry"],
            )
        )

    # ======================================================
    # VALIDATION
    # ======================================================

    completed, total = overview_complete(
        data
    )

    respondent_email_ok = valid_email(
        data["respondent_email"]
    )

    organisation_email_ok = valid_email(
        data["organisation_email"]
    )

    if (
        data["respondent_email"]
        and not respondent_email_ok
    ):

        st.error(
            "Please enter a valid assessment contact email address."
        )

    if (
        data["organisation_email"]
        and not organisation_email_ok
    ):

        st.error(
            "Please enter a valid organisation business email address."
        )

    return {

        "completed":
            completed,

        "total":
            total,

        "can_continue":
            (
                completed == total
                and respondent_email_ok
                and organisation_email_ok
            ),

        "on_continue":
            lambda: save(
                "overview",
                data,
            ),

    }
