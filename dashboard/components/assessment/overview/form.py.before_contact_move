import streamlit as st

from content.industries import INDUSTRIES
from content.countries import COUNTRIES

from components.assessment.validation import (
    overview_complete,
    valid_email,
)

from components.assessment.store import (
    save,
    load,
    assessment_id,
    set_assessment_id,
)

from components.assessment.id_generator import (
    generate,
)


def show():

    existing = load("overview")

    with st.container(border=True):

        st.markdown(
            """
            <div style="
                font-size:1.50rem;
                font-weight:750;
                line-height:1.1;
                margin-bottom:4px;
            ">
            Organisation Information
            </div>
            """,
            unsafe_allow_html=True,
        )

        st.caption(
            "Establish the organisational context required "
            "to assess current quantum-readiness posture."
        )

        left, right = st.columns(
            2,
            gap="small",
        )

        # ==================================================
        # LEFT
        # ==================================================

        with left:

            st.text_input(
                "Organisation Name *",
                key="organisation_name",
                value=existing.get(
                    "organisation_name",
                    "",
                ),
                placeholder="Enet Technologies Ltd",
            )

            st.selectbox(
                "Industry *",
                INDUSTRIES,
                key="industry",
                index=None,
                placeholder="Select industry",
            )

            st.selectbox(
                "Primary Business Model *",
                [
                    "Financial Services",
                    "Technology / Platform",
                    "Government / Public Sector",
                    "Healthcare",
                    "Manufacturing",
                    "Telecommunications",
                    "Energy / Utilities",
                    "Other",
                ],
                key="primary_business_model",
                index=None,
                placeholder="Select primary business model",
            )

            st.selectbox(
                "Organisation Size *",
                [
                    "1–50",
                    "51–250",
                    "251–1000",
                    "1000+",
                ],
                key="organisation_size",
                index=None,
                placeholder="Select organisation size",
            )

            st.radio(
                "Critical Infrastructure *",
                [
                    "Yes",
                    "No",
                ],
                horizontal=True,
                key="critical_infrastructure",
            )

        # ==================================================
        # RIGHT
        # ==================================================

        with right:

            st.text_input(
                "Official Business Email *",
                key="organisation_email",
                value=existing.get(
                    "organisation_email",
                    "",
                ),
                placeholder="security@company.com",
            )

            st.selectbox(
                "Country *",
                COUNTRIES,
                key="country",
                index=None,
                placeholder="Select country",
            )

            st.multiselect(
                "Regulatory Environment *",
                [
                    "Data Protection / Privacy",
                    "Banking / Financial Services",
                    "Healthcare Regulation",
                    "Payment / Financial Infrastructure",
                    "Telecommunications",
                    "Energy / Utilities Regulation",
                    "International / Cross-Border",
                    "Other",
                ],
                key="regulatory_environment",
                default=existing.get(
                    "regulatory_environment",
                    [],
                ),
                placeholder=(
                    "Select applicable regulatory environments"
                ),
            )

            st.multiselect(
                "Most Critical Business Services *",
                [
                    "Core Banking / Financial Services",
                    "Payments",
                    "Customer Identity",
                    "Digital Channels",
                    "Communication Services",
                    "Data Processing",
                    "Cloud Services",
                    "Other",
                ],
                key="critical_business_services",
                default=existing.get(
                    "critical_business_services",
                    [],
                ),
                placeholder="Select critical services",
            )

    # ======================================================
    # DATA
    #
    # Quantum Threat Horizon is intentionally NOT collected
    # here. EQMP generates Z internally.
    # ======================================================

    data = {

        "organisation_name":
            st.session_state.get(
                "organisation_name",
                "",
            ),

        "organisation_email":
            st.session_state.get(
                "organisation_email",
                "",
            ),

        "industry":
            st.session_state.get(
                "industry"
            ),

        "country":
            st.session_state.get(
                "country"
            ),

        "primary_business_model":
            st.session_state.get(
                "primary_business_model"
            ),

        "regulatory_environment":
            st.session_state.get(
                "regulatory_environment",
                [],
            ),

        "organisation_size":
            st.session_state.get(
                "organisation_size"
            ),

        "critical_business_services":
            st.session_state.get(
                "critical_business_services",
                [],
            ),

        "critical_infrastructure":
            st.session_state.get(
                "critical_infrastructure"
            ),

    }

    save(
        "overview",
        data,
    )

    # ======================================================
    # Assessment ID
    # ======================================================

    if (
        assessment_id() is None
        and data["country"]
        and data["industry"]
    ):

        set_assessment_id(
            generate(
                data["country"],
                data["industry"],
            )
        )

    # ======================================================
    # Validation
    # ======================================================

    completed, total = overview_complete(
        data
    )

    email_ok = valid_email(
        data["organisation_email"]
    )

    if (
        data["organisation_email"]
        and not email_ok
    ):

        st.error(
            "Please enter a valid business email address."
        )

    return {

        "completed":
            completed,

        "total":
            total,

        "can_continue":
            (
                completed == total
                and email_ok
            ),

        "on_continue":
            lambda: save(
                "overview",
                data,
            ),

    }
