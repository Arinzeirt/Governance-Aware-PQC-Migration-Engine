import streamlit as st

from components.assessment.status import readiness_percentage
from components.assessment.store import (
    last_saved,
    assessment_id,
)


STEP_LABELS = {

    1:
        "Continue to Business & Data Exposure →",

    2:
        "Continue to Technology Landscape →",

    3:
        "Continue to Cryptographic Posture →",

    4:
        "Continue to Assessment Review →",

    5:
        "View Assessment Results →",

}


def show(
    current_step,
    current_step_label,
    completed,
    total,
    can_continue=True,
    on_continue=None,
):

    progress = readiness_percentage(
        completed,
        total,
    )

    saved = last_saved()
    aid = assessment_id()

    with st.container(border=True):

        st.markdown(
            """
            <div style="
                font-size:1.05rem;
                font-weight:700;
                margin-bottom:12px;
            ">
                Assessment Summary
            </div>
            """,
            unsafe_allow_html=True,
        )

        st.caption("ASSESSMENT ID")

        if aid:

            st.markdown(
                f"""
                <div style="
                    background:#20242D;
                    border-radius:7px;
                    padding:8px 10px;
                    font-family:monospace;
                    font-size:0.68rem;
                    white-space:nowrap;
                    overflow:hidden;
                    text-overflow:ellipsis;
                    margin-bottom:12px;
                ">
                    {aid}
                </div>
                """,
                unsafe_allow_html=True,
            )

        else:

            st.caption("Pending Assignment")

        st.caption("CURRENT STEP")

        st.markdown(
            f"""
            <div style="
                font-size:0.82rem;
                font-weight:650;
                margin-bottom:12px;
            ">
                {current_step_label}
            </div>
            """,
            unsafe_allow_html=True,
        )

        st.caption("ASSESSMENT COMPLETION")

        c1, c2 = st.columns(2)

        with c1:

            st.markdown(
                f"""
                <div style="font-size:1rem;font-weight:750;">
                    {completed}/{total}
                </div>

                <div style="
                    font-size:0.60rem;
                    color:#8FA1B5;
                ">
                    Fields completed
                </div>
                """,
                unsafe_allow_html=True,
            )

        with c2:

            st.markdown(
                f"""
                <div style="
                    font-size:1rem;
                    font-weight:750;
                    color:#2F81F7;
                ">
                    {progress}%
                </div>

                <div style="
                    font-size:0.60rem;
                    color:#8FA1B5;
                ">
                    Overall progress
                </div>
                """,
                unsafe_allow_html=True,
            )

        st.progress(
            progress / 100
        )

        st.caption("AUTO SAVE")

        saved_text = (
            saved.strftime("%H:%M:%S")
            if saved
            else "--"
        )

        st.markdown(
            f"""
            <div style="
                font-size:0.68rem;
                color:#B8C5D3;
                margin-top:-5px;
                margin-bottom:16px;
            ">
                <span style="color:#18A558;">●</span>
                Active
                &nbsp;·&nbsp;
                Last saved {saved_text}
            </div>
            """,
            unsafe_allow_html=True,
        )

        if current_step > 1:

            if st.button(
                "← Back",
                key=f"assessment_back_{current_step}",
                use_container_width=True,
            ):

                st.session_state.assessment["step"] -= 1
                st.rerun()

        if st.button(
            STEP_LABELS.get(
                current_step,
                "Continue →",
            ),
            key=f"assessment_next_{current_step}",
            type="primary",
            use_container_width=True,
            disabled=not can_continue,
        ):

            if on_continue:

                on_continue()

            if current_step < 5:

                st.session_state.assessment[
                    "step"
                ] += 1

                st.rerun()

            else:

                st.session_state[
                    "assessment_results"
                ] = True

                st.session_state.pop(
                    "preview",
                    None,
                )

                st.rerun()

        if not can_continue:

            st.caption(
                "Complete all required fields to continue."
            )

        elif current_step == 5:

            st.caption(
                "Assessment complete. View your EQMP results."
            )

        else:

            st.caption(
                "All required fields completed."
            )
