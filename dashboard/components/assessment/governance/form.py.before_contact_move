import streamlit as st

from components.assessment.store import (
    save,
    load,
)

from components.assessment.validation import (
    governance_complete,
)


def show():

    existing = load("governance")

    # =========================================================
    # Governance
    # =========================================================

    with st.container(border=True):

        st.markdown(
            """
            <div style="
                font-size:1.50rem;
                font-weight:750;
                line-height:1.1;
                margin-bottom:4px;
            ">
                Governance
            </div>
            """,
            unsafe_allow_html=True,
        )

        st.markdown(
            """
            <div style="
                font-size:0.78rem;
                color:#7f8da3;
                margin-bottom:14px;
            ">
                Establish accountability, decision ownership and
                organisational governance for post-quantum transition.
            </div>
            """,
            unsafe_allow_html=True,
        )

        # =====================================================
        # Assessment Contact
        # =====================================================

        st.markdown(
            """
            <div style="
                font-size:0.90rem;
                font-weight:700;
                margin-bottom:7px;
            ">
                Assessment Contact
            </div>
            """,
            unsafe_allow_html=True,
        )

        contact_left, contact_right = st.columns(
            2,
            gap="medium",
        )

        with contact_left:

            st.text_input(
                "Full Name *",
                key="respondent_name",
                value=existing.get(
                    "respondent_name",
                    "",
                ),
                placeholder="Full name",
            )

        with contact_right:

            roles = [
                "Executive / C-Suite",
                "CIO / CTO",
                "CISO / Security Lead",
                "IT / Infrastructure",
                "Risk / Compliance",
                "Architecture / Engineering",
                "Audit",
                "Other",
            ]

            existing_role = existing.get(
                "respondent_role"
            )

            role_index = (
                roles.index(existing_role)
                if existing_role in roles
                else None
            )

            st.selectbox(
                "Role / Job Title *",
                roles,
                index=role_index,
                key="respondent_role",
                placeholder="Select role",
            )

        st.text_input(
            "Business Email *",
            key="respondent_email",
            value=existing.get(
                "respondent_email",
                "",
            ),
            placeholder="name@company.com",
        )

        # =====================================================
        # Governance Foundation
        # =====================================================

        st.markdown(
            """
            <div style="
                font-size:0.90rem;
                font-weight:700;
                margin:14px 0 7px 0;
            ">
                Governance Foundation
            </div>
            """,
            unsafe_allow_html=True,
        )

        left, right = st.columns(
            2,
            gap="medium",
        )

        with left:

            st.radio(
                "Cybersecurity / Technology Risk Governance *",
                [
                    "Established",
                    "In Development",
                    "Not Established",
                    "Not Sure",
                ],
                horizontal=True,
                key="security_governance",
            )

            st.radio(
                "Cryptographic Risk Owner *",
                [
                    "Assigned",
                    "Shared / Unclear",
                    "Not Assigned",
                    "Not Sure",
                ],
                horizontal=True,
                key="crypto_risk_owner",
            )

            st.radio(
                "Cryptographic Policy *",
                [
                    "Documented",
                    "Partial",
                    "No Formal Policy",
                    "Not Sure",
                ],
                horizontal=True,
                key="crypto_policy",
            )

        with right:

            st.radio(
                "Cryptographic Risk in Enterprise Risk Process *",
                [
                    "Included",
                    "In Development",
                    "Not Included",
                    "Not Sure",
                ],
                horizontal=True,
                key="risk_register",
            )

            st.radio(
                "Cryptographic Change / Approval Process *",
                [
                    "Formal",
                    "Informal",
                    "None",
                    "Not Sure",
                ],
                horizontal=True,
                key="crypto_change_process",
            )

            st.radio(
                "Regulatory / Compliance Accountability *",
                [
                    "Established",
                    "In Development",
                    "Not Established",
                    "Not Sure",
                ],
                horizontal=True,
                key="compliance_program",
            )

        # =====================================================
        # Post-Quantum Governance
        # =====================================================

        st.markdown(
            """
            <div style="
                font-size:0.90rem;
                font-weight:700;
                margin:14px 0 7px 0;
            ">
                Post-Quantum Governance
            </div>
            """,
            unsafe_allow_html=True,
        )

        left, right = st.columns(
            2,
            gap="medium",
        )

        with left:

            st.radio(
                "Post-Quantum Strategy *",
                [
                    "Established",
                    "In Development",
                    "Not Started",
                    "Not Sure",
                ],
                horizontal=True,
                key="pqc_strategy",
            )

            st.radio(
                "PQC Migration Ownership *",
                [
                    "Assigned",
                    "Under Discussion",
                    "Not Assigned",
                    "Not Sure",
                ],
                horizontal=True,
                key="pqc_owner",
            )

        with right:

            st.radio(
                "Executive Sponsorship *",
                [
                    "Confirmed",
                    "Under Consideration",
                    "None",
                    "Not Sure",
                ],
                horizontal=True,
                key="executive_support",
            )

            st.radio(
                "Confidence in Governance Information *",
                [
                    "High",
                    "Moderate",
                    "Limited",
                ],
                horizontal=True,
                key="governance_confidence",
            )

    # =========================================================
    # Persist
    # =========================================================

    data = {

        "respondent_name":
            st.session_state.get(
                "respondent_name",
                "",
            ),

        "respondent_role":
            st.session_state.get(
                "respondent_role"
            ),

        "respondent_email":
            st.session_state.get(
                "respondent_email",
                "",
            ),

        "security_governance":
            st.session_state.get(
                "security_governance"
            ),

        "crypto_risk_owner":
            st.session_state.get(
                "crypto_risk_owner"
            ),

        "risk_register":
            st.session_state.get(
                "risk_register"
            ),

        "crypto_policy":
            st.session_state.get(
                "crypto_policy"
            ),

        "crypto_change_process":
            st.session_state.get(
                "crypto_change_process"
            ),

        "compliance_program":
            st.session_state.get(
                "compliance_program"
            ),

        "pqc_strategy":
            st.session_state.get(
                "pqc_strategy"
            ),

        "pqc_owner":
            st.session_state.get(
                "pqc_owner"
            ),

        "executive_support":
            st.session_state.get(
                "executive_support"
            ),

        "governance_confidence":
            st.session_state.get(
                "governance_confidence"
            ),

    }

    save(
        "governance",
        data,
    )

    completed, total = governance_complete(
        data
    )

    return {

        "completed":
            completed,

        "total":
            total,

        "can_continue":
            completed == total,

        "on_continue":
            lambda: save(
                "governance",
                data,
            ),

    }
