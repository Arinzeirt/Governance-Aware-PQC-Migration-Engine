import re


EMAIL_REGEX = r"^[^@\s]+@[^@\s]+\.[^@\s]+$"


def valid_email(email):

    return bool(
        re.match(
            EMAIL_REGEX,
            email or "",
        )
    )


# ==========================================================
# Enterprise Profile
# ==========================================================

def overview_complete(data):

    required = [

        "organisation_name",
        "organisation_email",
        "industry",
        "country",
        "primary_business_model",
        "regulatory_environment",
        "organisation_size",
        "critical_business_services",
        "critical_infrastructure",

    ]

    completed = sum(
        1
        for field in required
        if data.get(field)
    )

    return completed, len(required)


