import streamlit as st


def show():

    if not st.session_state.get(
        "eqmp_authenticated",
        False,
    ):

        st.session_state.page = "login"
        st.rerun()

    st.markdown(
        """
<div style="margin-bottom:22px;">
<div style="font-size:1.75rem;font-weight:800;">
Discovery
</div>

<div style="
    color:#8FA1B5;
    font-size:0.88rem;
    margin-top:4px;
">
Discover the enterprise environment, assets, cryptographic
dependencies and evidence required for migration decisions.
</div>
</div>
""",
        unsafe_allow_html=True,
    )

    st.info(
        "Discovery workspace foundation. "
        "Environment inventory and evidence collection will be connected here."
    )

    if st.button(
        "← Command Center",
        key="discovery_back",
    ):

        st.session_state.page = "command_center"
        st.rerun()
