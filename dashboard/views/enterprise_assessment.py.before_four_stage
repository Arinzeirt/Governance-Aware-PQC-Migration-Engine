import streamlit as st

from components.assessment.shell import (
    show as assessment_shell,
)

from components.assessment.governance.page import (
    show as governance,
)

from components.assessment.overview.page import (
    show as overview,
)

from components.assessment.technology.page import (
    show as technology,
)

from components.assessment.cryptography.page import (
    show as cryptography,
)

from components.assessment.review.page import (
    show as review,
)

from components.assessment.results.page import (
    show as results,
)


def show():

    # ---------------------------------------------------------
    # Assessment state
    # ---------------------------------------------------------

    if "assessment" not in st.session_state:

        st.session_state.assessment = {
            "step": 1,
        }

    # ---------------------------------------------------------
    # Results
    # ---------------------------------------------------------

    if st.session_state.get(
        "assessment_results",
        False,
    ):

        results()

        return

    # ---------------------------------------------------------
    # Current step
    # ---------------------------------------------------------

    step = st.session_state.assessment.get(
        "step",
        1,
    )

    # ---------------------------------------------------------
    # AUTHORITATIVE ASSESSMENT FLOW
    #
    # 1 Governance
    # 2 Business & Data Exposure
    # 3 Technology Landscape
    # 4 Cryptographic Posture
    # 5 Review
    # ---------------------------------------------------------

    pages = {

        1: governance,

        2: overview,

        3: technology,

        4: cryptography,

        5: review,

    }

    renderer = pages.get(
        step,
        governance,
    )

    assessment_shell(
        {
            "step": step,
            "renderer": renderer,
        }
    )
